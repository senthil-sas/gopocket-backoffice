{
  "compilerOptions": {
    "target": "ES2020",
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "strict": true,
    "skipLibCheck": true,
  "allowJs": true,
  "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
  "isolatedModules": true,
  "noEmit": true,
    "lib": ["ESNext", "DOM"],
  "types": ["vite/client"]
  },
  "include": ["src"]
}
